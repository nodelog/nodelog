<%- include('header') %>
<% if (doc != null) { %>
<input type="hidden" class="js-doc-id" value="<%- doc._id %>"/>

<div class="layout">
<div class="layout-main">
<article class="article-detail">
    <ol class="breadcrumb" aria-label="面包屑">
        <li><a href="/" title="首页">首页</a></li>
        <li><a href="/content/category?categoryId=<%= doc.category %>&page=1" title="<%= doc.categoryName || '未分类' %>"><%= doc.categoryName || '未分类' %></a></li>
        <li class="active" aria-current="page">正文</li>
    </ol>

    <h1 class="article-title"><%= doc.name %></h1>
    <div class="article-meta">
        <span><%= doc.realName || doc.userName || '佚名' %></span>
        <span><%= doc.categoryName || '未分类' %></span>
        <time datetime="<%= format(doc.createTime, "YYYY-MM-DD") %>"><%= format(doc.createTime, "YYYY-MM-DD") %></time>
        <span><%= doc.view %> 次阅读</span>
        <button type="button" class="btn btn-sm js-share-btn" aria-label="分享文章" title="分享文章">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><path d="m8.6 10.6 6.8-4M8.6 13.4l6.8 4"/></svg>分享
        </button>
        <% if (session.user != null && session.user._id == doc.author) { %>
        <a href="/content/edit?id=<%= doc._id %>&view=editContent" class="btn btn-primary">编辑</a>
        <button type="button" class="btn js-delete-article" data-id="<%= doc._id %>">删除</button>
        <% } else { %>
        <a href="javascript:;" class="js-open-comment-btn" role="button">发表评论</a>
        <% } %>
    </div>

    <% if (doc.tags && doc.tags.length) { %>
    <div class="tag-chips article-tags">
        <% doc.tags.forEach(function(t){ %><a class="chip" href="/tag/<%= encodeURIComponent(t) %>"><%= t %></a><% }); %>
    </div>
    <% } %>

    <% if (doc.excerpt) { %><p class="lead"><%= doc.excerpt %></p><% } %>

    <div class="card article-body js-content">
        <div class="article-content"><%- doc.renderedContent %></div>
        <% if (doc.original) { %>
        <div class="alert" role="alert">原文链接：<a href="<%= doc.original %>" target="_blank" rel="noopener"><%= doc.original %></a></div>
        <% } %>
    </div>
</article>

<section class="card comments">
    <h2 class="js-comment-title">评论</h2>
    <div class="js-all-comment hide" aria-hidden="true"></div>
    <div class="js-comment-panel"><%- include('common/state', { kind: 'loading', size: 'block' }) %></div>
    <div class="hide js-more-comment">
        <button type="button" class="btn js-more-comment-btn">加载更多</button>
    </div>
</section>

<section class="card">
    <h2>发表评论</h2>
    <form role="form" action="javascript:;">
        <div class="form-group">
            <label for="commentInput">内容</label>
            <textarea id="commentInput" class="js-comment-input form-control" rows="4" placeholder="登录后可以发表评论"></textarea>
        </div>
        <button type="submit" class="btn btn-primary js-post-comment-btn"
                data-id="<%= doc._id %>" data-email="<%= doc.email %>" data-name="<%= doc.name %>" disabled>发表评论</button>
    </form>
</section>
</div><!-- /.layout-main -->
<%- include('common/sidebar') %>
</div><!-- /.layout -->

<% } else { %>
<h1 class="sr-only">文章没有找到</h1>
<%- include('common/state', { kind: 'empty', size: 'block', title: '这篇文章可能已被删除', text: '返回首页继续浏览', actionHref: '/', actionText: '返回首页' }) %>
<% } %>
<% if (typeof doc !== 'undefined' && doc != null && session.user != null && session.user._id == doc.author) { %>
<input type="hidden" class="js-current-menu" value="js-my-content-menu"/>
<% } %>
<% /* 正文图片点击看原图：正文图片已按 760px 限宽居中，点开查看原始大图。
      纯原生、无第三方依赖；事件委托到 .article-content，不写任何 data 属性、不污染 Markdown。 */ %>
<style>
  .nl-lightbox { position: fixed; inset: 0; z-index: 2147483000; display: none; align-items: center; justify-content: center;
    background: rgba(0,0,0,.86); padding: 24px; cursor: zoom-out; }
  .nl-lightbox.is-open { display: flex; }
  .nl-lightbox img { max-width: 96vw; max-height: 92vh; width: auto; height: auto; object-fit: contain;
    border-radius: var(--radius-sm); cursor: default; box-shadow: var(--shadow-lg); }
  .nl-lightbox__close { position: absolute; top: 16px; right: 22px; color: var(--brand-primary-ink); font-size: 30px; line-height: 1;
    background: none; border: 0; cursor: pointer; padding: 4px 10px; }
  .article-content img { cursor: zoom-in; }
</style>
<div class="nl-lightbox" role="dialog" aria-modal="true" aria-label="查看原图" aria-hidden="true">
  <button type="button" class="nl-lightbox__close" aria-label="关闭">×</button>
  <img alt="" src=""/>
</div>

<!-- 分享浮层：微信内走右上角菜单(JS-SDK 已配置)，站外走 微博/QQ/复制链接 -->
<div class="nl-share" id="nlShare" role="dialog" aria-modal="true" aria-label="分享文章" aria-hidden="true" hidden>
  <div class="nl-share__panel">
    <div class="nl-share__head">
      <h2>分享这篇文章</h2>
      <button type="button" class="icon-btn nl-share__close" id="nlShareClose" aria-label="关闭分享">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
      </button>
    </div>
    <p class="nl-share__title" id="nlShareTitle"></p>
    <div class="nl-share__qr">
      <div class="nl-share__qr-box"><img id="nlShareQrImg" alt="扫码访问这篇文章"/></div>
      <p>扫码在手机上打开</p>
    </div>
    <div class="nl-share__wechat" id="nlShareWechat">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="M4 12a8 8 0 0 1 16 0"/><path d="M12 4v4M8 16l4 4 4-4"/></svg>
      在微信里点右上角「···」转发给好友或朋友圈
    </div>
    <div class="nl-share__actions">
      <a class="btn" id="nlShareWeibo" target="_blank" rel="noopener" href="#">微博</a>
      <a class="btn" id="nlShareQq" target="_blank" rel="noopener" href="#">QQ</a>
      <button type="button" class="btn btn-primary" id="nlShareCopy">复制链接</button>
    </div>
    <input type="text" class="nl-share__link" id="nlShareLink" readonly aria-label="文章链接"/>
  </div>
</div>
<script>
(function () {
  var box = document.querySelector('.nl-lightbox');
  var boxImg = box && box.querySelector('img');
  var content = document.querySelector('.article-content');
  if (!box || !boxImg || !content) return;
  function close() { box.classList.remove('is-open'); box.setAttribute('aria-hidden', 'true'); boxImg.removeAttribute('src'); }
  content.addEventListener('dblclick', function (e) {
    var img = e.target && e.target.closest && e.target.closest('img');
    if (!img || !content.contains(img)) return;
    var src = img.getAttribute('src');
    if (!src) return;
    e.preventDefault();
    boxImg.src = src;
    boxImg.alt = img.getAttribute('alt') || '';
    box.classList.add('is-open');
    box.setAttribute('aria-hidden', 'false');
  });
  box.addEventListener('click', function (e) { if (e.target === box || e.target.closest('.nl-lightbox__close')) close(); });
  document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && box.classList.contains('is-open')) close(); });
})();
</script>

<script>
/* 分享浮层：从页面 og meta 读标题/摘要/封面，与微信 JS-SDK 分享内容一致 */
(function () {
  var btn = document.querySelector('.js-share-btn');
  var panel = document.getElementById('nlShare');
  if (!btn || !panel) return;
  var titleEl = document.getElementById('nlShareTitle');
  var linkEl = document.getElementById('nlShareLink');
  var weibo = document.getElementById('nlShareWeibo');
  var qq = document.getElementById('nlShareQq');
  var copyBtn = document.getElementById('nlShareCopy');
  var closeBtn = document.getElementById('nlShareClose');
  var inWechat = /MicroMessenger/i.test(navigator.userAgent);

  function meta(p) { var el = document.querySelector('meta[property="' + p + '"]'); return el ? (el.getAttribute('content') || '') : ''; }
  var url = location.href.split('#')[0];
  var title = meta('og:title') || document.title || '';
  var desc = meta('og:description') || '';

  if (titleEl) titleEl.textContent = title;
  if (linkEl) linkEl.value = url;
  if (weibo) weibo.href = 'https://service.weibo.com/share/share.php?url=' + encodeURIComponent(url) + '&title=' + encodeURIComponent(title + ' ' + desc);
  if (qq) qq.href = 'https://connect.qq.com/widget/shareqq/index.html?url=' + encodeURIComponent(url) + '&title=' + encodeURIComponent(title) + '&desc=' + encodeURIComponent(desc);
  // 微信内隐藏"右上角提示"？不隐藏——微信内 JS-SDK 已配置，提示用户用菜单即可
  if (copyBtn) copyBtn.addEventListener('click', function () {
    var done = function () { if (window.NL && NL.toast) NL.toast('链接已复制'); };
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(url).then(done, function () { linkEl.select(); document.execCommand('copy'); done(); });
    } else { linkEl.select(); try { document.execCommand('copy'); } catch (e) {} done(); }
  });
  var qrImg = document.getElementById('nlShareQrImg');
  var qrLoaded = false;
  function loadQr() {
    if (qrLoaded) return;
    fetch('/api/qrcode?text=' + encodeURIComponent(url), {credentials: 'same-origin'})
      .then(function (r) { return r.json(); })
      .then(function (j) {
        if (j.success && j.url && qrImg) { qrImg.src = j.url; qrLoaded = true; }
      })
      .catch(function () { /* 二维码失败不影响其它分享方式 */ });
  }
  function open() { panel.hidden = false; panel.setAttribute('aria-hidden', 'false'); loadQr(); }
  function close() { panel.hidden = true; panel.setAttribute('aria-hidden', 'true'); }
  btn.addEventListener('click', open);
  if (closeBtn) closeBtn.addEventListener('click', close);
  panel.addEventListener('click', function (e) { if (e.target === panel) close(); });
  document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && !panel.hidden) close(); });
})();
</script>
<%- include('footer') %>
