<%- include('header') %>
<% if (doc != null) { %>
<input type="hidden" class="js-doc-id" value="<%- doc._id %>"/>

<article class="article-detail">
    <ol class="breadcrumb" aria-label="面包屑">
        <li><a href="/" title="首页">首页</a></li>
        <li><a href="/content/category?categoryId=<%= doc.category %>&page=1" title="<%= doc.categoryName || '未分类' %>"><%= doc.categoryName || '未分类' %></a></li>
        <li class="active" aria-current="page">正文</li>
    </ol>

    <h1 class="article-title"><%= doc.name %></h1>
    <div class="article-meta">
        <span><%= doc.realName ? doc.realName : doc.userName %></span>
        <span><%= doc.categoryName || '未分类' %></span>
        <time datetime="<%= format(doc.createTime, "YYYY-MM-DD") %>"><%= format(doc.createTime, "YYYY-MM-DD") %></time>
        <span><%= doc.view %> 次阅读</span>
        <% if (session.user != null && session.user._id == doc.author) { %>
        <a href="/content/edit?id=<%= doc._id %>&view=editContent" class="btn btn-primary">编辑</a>
        <% } else { %>
        <a href="javascript:;" class="js-open-comment-btn" role="button">发表评论</a>
        <% } %>
    </div>

    <% if (doc.tags && doc.tags.length) { %>
    <div class="tag-chips article-tags">
        <% doc.tags.forEach(function(t){ %><a class="chip" href="/tag/<%= encodeURIComponent(t) %>"><%= t %></a><% }); %>
    </div>
    <% } %>

    <div class="card article-body js-content">
        <div class="article-content"><%- doc.renderedContent %></div>
        <% if (doc.original) { %>
        <div class="alert" role="alert">原文链接：<a href="<%= doc.original %>" target="_blank" rel="noopener"><%= doc.original %></a></div>
        <% } %>
    </div>
</article>

<section class="card">
    <h2 class="js-comment-title">评论</h2>
    <div class="js-all-comment hide" aria-hidden="true"></div>
    <div class="js-comment-panel"><%- include('common/state', { kind: 'loading', size: 'block' }) %></div>
    <div class="hide js-more-comment">
        <button type="button" class="btn js-more-comment-btn">加载更多</button>
    </div>
</section>

<section class="card">
    <h2>发表评论</h2>
    <form role="form" action="javascript:;">
        <div class="form-group">
            <label for="commentInput">内容</label>
            <textarea id="commentInput" class="js-comment-input form-control" rows="4" placeholder="登录后可以发表评论"></textarea>
        </div>
        <button type="submit" class="btn btn-primary js-post-comment-btn"
                data-id="<%= doc._id %>" data-email="<%= doc.email %>" data-name="<%= doc.name %>" disabled>发表评论</button>
    </form>
</section>

<% } else { %>
<h1 class="sr-only">文章没有找到</h1>
<%- include('common/state', { kind: 'empty', size: 'block', title: '这篇文章可能已被删除', text: '返回首页继续浏览', actionHref: '/', actionText: '返回首页' }) %>
<% } %>
<% if (typeof doc !== 'undefined' && doc != null && session.user != null && session.user._id == doc.author) { %>
<input type="hidden" class="js-current-menu" value="js-my-content-menu"/>
<% } %>
<% /* 正文图片点击看原图：正文图片已按 760px 限宽居中，点开查看原始大图。
      纯原生、无第三方依赖；事件委托到 .article-content，不写任何 data 属性、不污染 Markdown。 */ %>
<style>
  .nl-lightbox { position: fixed; inset: 0; z-index: 2147483000; display: none; align-items: center; justify-content: center;
    background: rgba(0,0,0,.86); padding: 24px; cursor: zoom-out; }
  .nl-lightbox.is-open { display: flex; }
  .nl-lightbox img { max-width: 96vw; max-height: 92vh; width: auto; height: auto; object-fit: contain;
    border-radius: 4px; cursor: default; box-shadow: 0 8px 40px rgba(0,0,0,.5); }
  .nl-lightbox__close { position: absolute; top: 16px; right: 22px; color: #fff; font-size: 30px; line-height: 1;
    background: none; border: 0; cursor: pointer; padding: 4px 10px; }
</style>
<div class="nl-lightbox" role="dialog" aria-modal="true" aria-label="查看原图" aria-hidden="true">
  <button type="button" class="nl-lightbox__close" aria-label="关闭">×</button>
  <img alt="" src=""/>
</div>
<script>
(function () {
  var box = document.querySelector('.nl-lightbox');
  var boxImg = box && box.querySelector('img');
  var content = document.querySelector('.article-content');
  if (!box || !boxImg || !content) return;
  function close() { box.classList.remove('is-open'); box.setAttribute('aria-hidden', 'true'); boxImg.removeAttribute('src'); }
  content.addEventListener('click', function (e) {
    var img = e.target && e.target.closest && e.target.closest('img');
    if (!img || !content.contains(img)) return;
    var src = img.getAttribute('src');
    if (!src) return;
    e.preventDefault();
    boxImg.src = src;
    boxImg.alt = img.getAttribute('alt') || '';
    box.classList.add('is-open');
    box.setAttribute('aria-hidden', 'false');
  });
  box.addEventListener('click', function (e) { if (e.target === box || e.target.closest('.nl-lightbox__close')) close(); });
  document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && box.classList.contains('is-open')) close(); });
})();
</script>
<%- include('footer') %>
