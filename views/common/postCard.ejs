<%
  // 三种版式：lead（首页首篇，唯一 h1，跨满宽度）/ grid（2 列卡片）/ list（索引列表条目）
  var v = (typeof variant !== 'undefined' && variant) ? variant
        : ((typeof lead !== 'undefined' && lead) ? 'lead' : 'grid');
  var isLead = (v === 'lead');
  var isList = (v === 'list');
  var _date = format(doc.createTime || doc.modifyTime, 'YYYY-MM-DD');
%>
<article class="post-card post-card--<%= v %>">
    <% if (isLead && doc.cover) { %>
    <a class="post-cover post-cover--lead" href="/content/detail?id=<%= doc._id %>" tabindex="-1" aria-hidden="true">
        <img class="cover" src="<%= doc.cover %>" alt="<%= doc.name %>" width="1280" height="640" decoding="async">
        <span class="post-cover__shine" aria-hidden="true"></span>
    </a>
    <% } else if (!isList && doc.cover) { %>
    <a class="post-cover" href="/content/detail?id=<%= doc._id %>" tabindex="-1" aria-hidden="true">
        <img class="cover" src="<%= doc.cover %>" alt="<%= doc.name %>" width="640" height="360"
             decoding="async" loading="lazy">
    </a>
    <% } %>
    <div class="post-body">
        <% if (isLead) { %><span class="post-flag">精选</span><% } %>
        <% if (isLead) { %>
        <h1><a href="/content/detail?id=<%= doc._id %>"><%= doc.name %></a></h1>
        <% } else { %>
        <h2><a href="/content/detail?id=<%= doc._id %>"><%= doc.name %></a></h2>
        <% } %>
        <div class="meta">
            <span><%= doc.realName ? doc.realName : (doc.userName || '佚名') %></span>
            <span><%= doc.categoryName || '未分类' %></span>
            <time datetime="<%= _date %>"><%= _date %></time>
            <span><%= doc.view %> 次阅读</span>
            <% if (doc.readingTime) { %><span>约 <%= doc.readingTime %> 分钟</span><% } %>
        </div>
        <% if (doc.excerpt) { %><p class="excerpt"><%= doc.excerpt %></p><% } %>
        <% if (isLead) { %><a class="post-readmore" href="/content/detail?id=<%= doc._id %>">阅读全文 →</a><% } %>
        <% if (doc.tags && doc.tags.length) { %>
        <div class="tag-chips">
            <% doc.tags.forEach(function(t){ %><a class="chip" href="/tag/<%= encodeURIComponent(t) %>"><%= t %></a><% }); %>
        </div>
        <% } %>
        <% if (typeof isMyContent !== 'undefined' && isMyContent && typeof session !== 'undefined' && session && session.user && session.user._id == doc.author) { %>
        <div class="post-actions">
            <a class="btn btn-sm" href="/content/edit?id=<%= doc._id %>&view=editContent">编辑</a>
            <button type="button" class="btn btn-sm btn-danger js-delete-article" data-id="<%= doc._id %>">删除</button>
        </div>
        <% } %>
    </div>
</article>
