<article class="card post-card">
    <% if (doc.cover) { %><img class="cover" src="<%= doc.cover %>" alt="<%= doc.name %>"/><% } %>
    <h3><a href="/content/detail?id=<%= doc._id %>"><%= doc.name %></a></h3>
    <div class="meta">
        <span><i class="glyphicon glyphicon-user"></i> <%= doc.realName ? doc.realName : (doc.userName || '佚名') %></span>
        <span><i class="glyphicon glyphicon-tag"></i> <%= doc.categoryName || '未知' %></span>
        <span><i class="glyphicon glyphicon-calendar"></i> <%= format(doc.createTime || doc.modifyTime, 'YYYY-MM-DD') %></span>
        <span><i class="glyphicon glyphicon-eye-open"></i> <%= doc.view %></span>
        <% if (doc.readingTime) { %><span><i class="glyphicon glyphicon-time"></i> <%= doc.readingTime %> 分钟</span><% } %>
    </div>
    <% if (doc.excerpt) { %><p class="excerpt"><%= doc.excerpt %></p><% } %>
    <% if (doc.tags && doc.tags.length) { %>
        <div class="tag-chips">
            <% doc.tags.forEach(function(t){ %><a class="chip" href="/tag/<%= encodeURIComponent(t) %>"><%= t %></a><% }); %>
        </div>
    <% } %>
</article>
