<!-- 前台样式：theme.css（设计令牌 + 组件库）为唯一视觉源；app.css 仅补齐栅格 / 工具类 / 弹层等零依赖结构层（替代 bootstrap.css + layer.css） -->
<link rel="stylesheet" href="/css/theme.css">
<link rel="stylesheet" href="/css/app.css">
<% if (typeof needEditor !== 'undefined' && needEditor) { %>
<!-- 仅编辑页按需加载：编辑器图标 / 旧工具栏 / 代码高亮 -->
<link rel="stylesheet" href="/css/font-awesome.css">
<link rel="stylesheet" href="/css/index.css">
<% } %>
<link rel="manifest" href="/manifest.json">
<script>
  (function () {
    try {
      // 始终显式设置 data-theme，保证 CSS 变量、主题按钮图标与系统偏好三者一致
      var t = localStorage.getItem('nl-theme');
      if (!t) t = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      document.documentElement.setAttribute('data-theme', t);
    } catch (e) {}
    if ('serviceWorker' in navigator) {
      window.addEventListener('load', function () { navigator.serviceWorker.register('/sw.js').catch(function () {}); });
    }
  })();
</script>
<!-- 开放平台：微信自定义分享 / OG / Twitter 元数据（与后台 meta.ejs 保持一致） -->
<meta property="og:type" content="website">
<meta property="og:locale" content="zh_CN">
<% if (locals.title) { %>
<meta property="og:title" content="<%= title %> · <%= session.site.name %>">
<meta property="og:description" content="<%= title %> · <%= session.site.name %>">
<% } else { %>
<meta property="og:title" content="<%= session.site.name %>">
<meta property="og:description" content="<%= session.site.name %>">
<% } %>
<meta property="og:site_name" content="<%= session.site.name %>">
<% if (locals.ogUrl) { %>
<meta property="og:url" content="<%= ogUrl %>">
<% } %>
<% if (locals.shareCover) { %>
<meta property="og:image" content="<%= shareCover %>">
<meta name="twitter:image" content="<%= shareCover %>">
<% } %>
<meta property="og:image:width" content="480">
<meta property="og:image:height" content="480">
<meta name="twitter:card" content="summary_large_image">
<script src="/js/jweixin-1.6.0.js" defer></script>
<script>
  window.WX_SHARE_CONFIG = { api: '/open/jsConfig', imgUrl: <%- JSON.stringify(locals.shareCover || '').replace(/</g, '\\u003c') %> };
</script>
