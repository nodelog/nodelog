<%- include('header', { needEditor: true }) %>
<div class="page-head">
    <h1>编辑文章</h1>
    <p class="muted"><%= doc.name %></p>
</div>
<div class="card">
    <form role="form" action="javascript:;">
        <input type="hidden" class="js-content-type" value="<%= (doc.contentType=='markdown')?'markdown':'html' %>"/>
        <div class="form-group">
            <label for="contentTitle">标题 <span class="text-muted">（还可输入 <span class="js-content-name-chars">100</span> 字）</span></label>
            <input type="text" id="contentTitle" class="form-control js-add-content-name"
                   data-id="<%= doc._id %>" data-name="<%= doc.name %>" value="<%= doc.name %>"
                   placeholder="文章标题" autofocus maxlength="100"/>
        </div>
        <div class="form-group">
            <label>内容</label>
            <%- include('editor') %>
        </div>
        <div class="form-group">
            <label for="contentCategory">分类 <span class="text-muted">（输入可快速筛选）</span></label>
            <input type="text" id="contentCategoryFilter" class="form-control js-category-filter" placeholder="输入关键字筛选分类" style="margin-bottom:6px;"/>
            <select id="contentCategory" class="form-control js-category-value l-select"></select>
        </div>
        <div class="form-group">
            <label for="contentTags">标签 <span class="text-muted">（逗号分隔，可留空；点「自动生成」从标题/正文提取）</span></label>
            <div class="input-group">
                <input type="text" id="contentTags" class="form-control js-tags-value" value="<%= (doc.tags||[]).join(', ') %>" placeholder="如：Node.js, 运维, 教程"/>
                <span class="input-group-btn">
                    <button type="button" class="btn btn-default js-auto-tags">自动生成</button>
                </span>
            </div>
        </div>
        <div class="form-group">
            <label for="contentOriginal">原文 <span class="text-muted">（留空视为原创）</span></label>
            <input type="text" id="contentOriginal" class="form-control" name="original"
                   placeholder="原文链接" value="<%= (doc.original) ? doc.original : '' %>"/>
        </div>
        <button type="submit" class="btn btn-primary js-save-content">保存修改</button>
    </form>
</div>
<input type="hidden" value="<%= doc.category %>" class="js-edit-content-category"/>
<input type="hidden" class="js-current-menu" value="js-my-content-menu"/>
<%- include('footer', { needEditor: true }) %>
