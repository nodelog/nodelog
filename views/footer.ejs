</article>
</div>
<%- include('common/links') %>
<script data-main="/js/main" src="/js/require.js?v=3"></script>

<!-- 登录 / 注册弹层内容：common.js 会把 .js-*-panel 的 html 移入 layer 弹层，钩子不可改名 -->
<div class="hide">
    <div class="js-login-panel">
        <form action="javascript:;" class="auth-form">
            <h3>登录</h3>
            <div class="form-group">
                <label for="loginName">用户名</label>
                <input type="text" id="loginName" class="form-control js-login-username" placeholder="用户名" maxlength="20" autocomplete="username"/>
            </div>
            <div class="form-group">
                <label for="loginPwd">密码</label>
                <input type="password" id="loginPwd" class="form-control js-login-password" placeholder="密码" maxlength="20" autocomplete="current-password"/>
            </div>
            <button type="submit" class="btn btn-primary js-signIn-btn">登录</button>
        </form>
    </div>
    <div class="js-register-panel">
        <form action="javascript:;" class="auth-form">
            <h3>注册</h3>
            <div class="form-group">
                <label for="regName">用户名</label>
                <input type="text" id="regName" class="form-control js-register-username" placeholder="用户名" maxlength="20" autocomplete="username"/>
            </div>
            <div class="form-group">
                <label for="regPwd">密码</label>
                <input type="password" id="regPwd" class="form-control js-register-password" placeholder="密码" maxlength="20" autocomplete="new-password"/>
            </div>
            <div class="form-group">
                <label for="regPwd2">确认密码</label>
                <input type="password" id="regPwd2" class="form-control js-register-password2" placeholder="再次输入密码" maxlength="20" autocomplete="new-password"/>
            </div>
            <button type="submit" class="btn btn-primary js-signUp-btn">注册</button>
        </form>
    </div>
</div>
</body>
</html>
