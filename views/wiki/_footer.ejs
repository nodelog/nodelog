<!-- WP3 命令面板：知识库页默认只搜本库；右下角开关可开启「同时搜博客文章」 -->
<script>
window.CMD_SEARCH_CONFIG = {
  homeType: 'wiki',
  spaceId: <% if (typeof space !== 'undefined' && space && space._id) { %><%= JSON.stringify(String(space._id)) %><% } else { %>''<% } %>,
  placeholder: '搜索本知识库的文档…'
};
</script>
<script defer src="/js/cmd-search.js?v=20261121"></script>
