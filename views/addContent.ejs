<%- include('header', { needEditor: true }) %>
<div class="page-head">
    <h1>写文章</h1>
</div>
<div class="card">
    <form role="form" action="javascript:;">
        <input type="hidden" class="js-content-type" value="markdown"/>
        <div class="form-group">
            <label for="contentTitle">标题 <span class="text-muted">（还可输入 <span class="js-content-name-chars">100</span> 字）</span></label>
            <input type="text" id="contentTitle" class="form-control js-add-content-name" placeholder="文章标题" autofocus maxlength="100"/>
        </div>
        <div class="form-group">
            <label>内容</label>
            <%- include('editor') %>
        </div>
        <div class="form-group">
            <label for="contentCategory">分类 <span class="text-muted">（输入即可搜索，下拉里点选）</span></label>
            <div class="category-picker js-category-picker">
                <input type="text" id="contentCategory" class="form-control js-category-input" placeholder="搜索或选择分类" autocomplete="off"/>
                <input type="hidden" class="js-category-value"/>
                <ul class="category-picker__menu js-category-menu-list" role="listbox"></ul>
            </div>
        </div>
        <div class="form-group">
            <label for="contentTags">标签 <span class="text-muted">（逗号分隔，留空则发布时自动提取）</span></label>
            <div class="tag-field">
                <input type="text" id="contentTags" class="form-control js-tags-value" placeholder="如：Node.js, 运维, 教程"/>
                <button type="button" class="btn-ghost js-auto-tags" title="根据标题/正文自动提取标签">✨ 自动</button>
            </div>
            <div class="tag-preview js-tag-preview" aria-live="polite"></div>
            <p class="tag-hint js-tag-hint"></p>
        </div>
        <div class="form-group">
            <label for="contentOriginal">原文 <span class="text-muted">（留空视为原创）</span></label>
            <input type="text" id="contentOriginal" class="form-control" name="original" placeholder="原文链接"/>
        </div>
        <button type="submit" class="btn btn-primary js-save-content">发表文章</button>
    </form>
</div>
<input type="hidden" class="js-current-menu" value="js-post-log"/>
<%- include('footer', { needEditor: true }) %>
