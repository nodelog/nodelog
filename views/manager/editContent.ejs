<%- include('header') %>
<ol class="breadcrumb">
    <li><a href="/manager">后台首页</a></li>
    <li><a href="/manager/content?manager=true&page=1">文章</a></li>
    <li class="active">编辑</li>
</ol>
<h3>编辑文章 · <%= doc.name %></h3>

<form role="form" action="javascript:;">
    <input type="hidden" class="js-content-type" value="<%= (doc.contentType=='markdown')?'markdown':'html' %>"/>
    <div class="form-group">
        <label for="mgrContentTitle">标题 <span class="text-muted">（还可输入 <span class="js-content-name-chars">100</span> 字）</span></label>
        <input type="text" id="mgrContentTitle" class="form-control js-add-content-name"
               data-id="<%= doc._id %>" data-name="<%= doc.name %>" value="<%= doc.name %>"
               placeholder="文章标题" autofocus maxlength="100"/>
    </div>
    <div class="form-group">
        <label>内容</label>
        <%- include('../editor') %>
    </div>
    <div class="form-group">
        <label for="mgrContentCategory">分类</label>
        <input type="text" id="mgrContentCategoryFilter" class="form-control js-category-filter" placeholder="输入关键字筛选分类" style="margin-bottom:6px;"/>
        <select id="mgrContentCategory" class="form-control js-category-value l-select"></select>
    </div>
    <div class="form-group">
        <label for="mgrContentTags">标签 <span class="text-muted">（逗号分隔，可留空；点「自动生成」从标题/正文提取）</span></label>
        <div class="input-group">
            <input type="text" id="mgrContentTags" class="form-control js-tags-value" value="<%= (doc.tags||[]).join(', ') %>" placeholder="如：Node.js, 运维, 教程"/>
            <span class="input-group-btn">
                <button type="button" class="btn btn-default js-auto-tags">自动生成</button>
            </span>
        </div>
    </div>
    <button type="submit" class="btn btn-primary js-save-content">保存修改</button>
</form>

<%- include('footer') %>
<script>
    // 分类下拉取 JSON 接口（原先误指向渲染 HTML 的 /content/addPage，导致下拉永远为空）
    $(function () {
        var docs = [];
        function renderCat(v) {
            v = (v || '').trim().toLowerCase();
            var cur = $('#mgrContentCategory').val();
            var html = '';
            $.each(docs, function (i, c) {
                if (v === '' || (c.name || '').toLowerCase().indexOf(v) !== -1) {
                    var sel = (c._id == cur || (cur === '' && c._id == '<%=doc.category%>')) ? ' selected' : '';
                    html += '<option value="' + c._id + '"' + sel + '>' + c.name + '</option>';
                }
            });
            if (html === '') html = '<option value="">（无匹配分类）</option>';
            $('#mgrContentCategory').html(html);
        }
        $.get("/category/all", function (data) {
            docs = data.docs || [];
            renderCat('');
        }, "json");
        // 分类快速筛选
        $('#mgrContentCategoryFilter').on('input', function () { renderCat(this.value); });
    });
</script>
