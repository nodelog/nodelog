<%- include('header') %>
<ol class="breadcrumb">
    <li><a href="/manager">后台首页</a></li>
    <li><a href="/manager/content?manager=true&page=1">文章</a></li>
    <li class="active">编辑</li>
</ol>
<h3>编辑文章 · <%= doc.name %></h3>

<form role="form" action="javascript:;">
    <input type="hidden" class="js-content-type" value="<%= (doc.contentType=='markdown')?'markdown':'html' %>"/>
    <div class="form-group">
        <label for="mgrContentTitle">标题 <span class="text-muted">（还可输入 <span class="js-content-name-chars">100</span> 字）</span></label>
        <input type="text" id="mgrContentTitle" class="form-control js-add-content-name"
               data-id="<%= doc._id %>" data-name="<%= doc.name %>" value="<%= doc.name %>"
               placeholder="文章标题" autofocus maxlength="100"/>
    </div>
    <div class="form-group">
        <label>内容</label>
        <%- include('../editor') %>
    </div>
    <div class="form-group">
        <label for="mgrContentCategory">分类</label>
        <select id="mgrContentCategory" class="form-control js-category-value l-select"></select>
    </div>
    <button type="submit" class="btn btn-primary js-save-content">保存修改</button>
</form>

<%- include('footer') %>
<script>
    // 分类下拉取 JSON 接口（原先误指向渲染 HTML 的 /content/addPage，导致下拉永远为空）
    $(function () {
        $.get("/category/all", function (data) {
            var docs = data.docs || [];
            var options = "";
            $.each(docs, function (i, tempDoc) {
                var selected = tempDoc._id == '<%=doc.category%>' ? ' selected' : '';
                options += '<option value="' + tempDoc._id + '"' + selected + '>' + tempDoc.name + '</option>';
            });
            $('.js-category-value').html(options);
        }, "json");
    });
</script>
