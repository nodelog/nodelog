<%- include('header') %>

<div class="row js-panel-row">

    <div class="col-sm-12  col-xs-12">
        <% if (doc != null) { %>
        <ol class="breadcrumb">
            <li><a href="/manager">后台首页</a></li>
            <li><a href="/manager/content?page=1&manager=true">文章管理</a></li>
            <li class="active"><%= doc.name %></li>
        </ol>
        <div class="panel panel-default">
            <div class="panel-heading">
                <h4>
                    <a href="#" title="reload <%= doc.name %>"><i
                                class="glyphicon glyphicon-bookmark"></i>&nbsp;<%= doc.name %></a>

                    <div class="clearfix"></div>
                </h4>

                <div class="media color-gray">
                    <span title="ahther"><i
                                class="glyphicon glyphicon-pencil"></i>&nbsp;<%- doc.userName %></span>
                    <span title="category"><i
                                class="glyphicon glyphicon-tag col-sm-offset-1"></i>&nbsp;<%- doc.categoryName %></span>
                    <span title="time"><i
                                class="glyphicon glyphicon-time  col-sm-offset-1"></i>&nbsp;<%= format(doc.createTime) %></span>
                    <span title="view count"><i
                                class="glyphicon glyphicon-eye-open  col-sm-offset-1"></i>&nbsp;<%= doc.view %></span>
                </div>

            </div>
            <div class="panel-body">
                <div class="article-content"><%- doc.renderedContent %></div>
                <%if(doc.original){%>
                <div class="alert alert-success  no-margin l-margin-top-20" role="alert">
                    原文链接：<a href="<%= doc.original %>" class="alert-link" target="_blank"><%= doc.original %></a>
                </div>
                <%}%>
            </div>
        </div>
        <% } else { %>
        <div class="empty"><span class="empty-title">文章不存在</span>它可能已被删除或下架。</div>
        <% } %>
    </div>
    
</div>
<%- include('footer') %>
