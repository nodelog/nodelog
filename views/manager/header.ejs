<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <%- include('../common/meta') %>
</head>
<body class="bg-gray js-body manager">
<%- include('../common/icons') %>
<nav class="navbar nav-bg navbar-fixed-top bottom-border" role="navigation">
