<%- include('header') %>
<ol class="breadcrumb">
    <li><a href="/manager">后台首页</a></li>
    <li class="active">文章管理</li>
</ol>
<% if (typeof filters !== 'undefined') { %>
<% /* 新 /admin SSR 路由：crud.list 注入 filters/sortBy/order；老路由无 filters，走下方原样 legacy UI，role=1 零回归。 */ %>
<% var safeHref = function (u) { u = String(u == null ? '' : u).trim(); return (/^https?:\/\//i.test(u) || /^\/(?!\/)/.test(u)) ? u : '#'; }; %>
<% var _cf = [
     {n:'name', t:'标题', k:'text', req:1, max:200},
     {n:'content', t:'正文（列表接口不返回正文，编辑需粘贴完整正文）', k:'textarea', req:1},
     {n:'slug', t:'标识', k:'text', max:100},
     {n:'tags', t:'标签（逗号分隔）', k:'text', max:200},
     {n:'contentType', t:'正文格式', k:'select', o:[{v:'markdown',t:'Markdown'},{v:'html',t:'HTML'}], d:'markdown'}
   ]; %>
<% var _cef = _cf.concat([{n:'oldName', t:'原标题（勿改）', k:'text', max:200}]); %>
<h3>文章管理</h3>
<div class="admin-list">
  <%- include('../common/adminToolbar', { bar: {
      res: 'content', base: '/manager/content/admin',
      keyword: true,
      status: [{v:'0',t:'正常'},{v:'1',t:'禁用'},{v:'2',t:'私有'}],
      sort: [{v:'createTime',t:'创建时间'},{v:'modifyTime',t:'修改时间'},{v:'view',t:'浏览量'},{v:'name',t:'标题'}],
      batch: true, batchStatuses: [{v:'0',t:'正常'},{v:'1',t:'禁用'}],
      io: true,
      add: { label: '新增文章', api: '/content/add', editApi: '/manager/content/modify', fields: _cf }
  } }) %>
  <div class="bg-white jumbotron clear-margin">
    <% var _docs = Array.isArray(docs) ? docs : []; %>
    <% if (_docs.length > 0) { %>
    <table class="table table-hover">
      <thead>
      <tr>
        <th class="admin-col-check" aria-label="选择"></th>
        <th>编号</th>
        <th>标题</th>
        <th>作者</th>
        <th>分类</th>
        <th>发表时间</th>
        <th>修改时间</th>
        <th>浏览量</th>
        <th class="admin-col-status">状态</th>
        <th class="admin-col-actions">操作</th>
      </tr>
      </thead>
      <tbody>
      <% _docs.forEach(function (d, i) { %>
        <% var _id = String(d._id == null ? '' : d._id); %>
        <% var _nm = String(d.name == null ? '' : d.name); %>
        <% var _st = (d.status === 1 || String(d.status) === '1') ? '1' : ((d.status === 2 || String(d.status) === '2') ? '2' : '0'); %>
        <% var _stTxt = _st === '1' ? '禁用' : (_st === '2' ? '私有' : '正常'); %>
        <% var _href = safeHref('/manager/content/detail?id=' + _id); %>
        <tr data-id="<%= _id %>" data-name="<%= _nm %>" data-oldName="<%= _nm %>" data-slug="<%= d.slug || '' %>" data-tags="<%= Array.isArray(d.tags) ? d.tags.join(',') : (d.tags || '') %>" data-contentType="<%= d.contentType || 'markdown' %>" data-content="<%= d.content == null ? '' : String(d.content) %>" data-status="<%= _st %>">
          <td><input type="checkbox" class="js-batch-check" value="<%= _id %>" aria-label="选择 <%= _nm %>"></td>
          <td><%= i + 1 %></td>
          <td><a href="<%= _href %>"><%= _nm.length > 24 ? _nm.slice(0, 24) + '…' : _nm %></a></td>
          <td><%= d.realName || d.userName || '佚名' %></td>
          <td><%= d.categoryName || '' %></td>
          <td><%= format(d.createTime) %></td>
          <td><%= format(d.modifyTime) %></td>
          <td><%= d.view == null ? 0 : d.view %></td>
          <td><label class="admin-status-toggle">
              <input type="checkbox" class="js-admin-status" data-id="<%= _id %>" data-status="<%= _st %>" <%= _st === '0' ? 'checked' : '' %>>
              <span class="js-status-label"><%= _stTxt %></span>
            </label></td>
          <td class="admin-col-actions"><span class="admin-row-actions">
              <a href="<%= _href %>">详情</a>
              <button type="button" class="js-admin-edit" data-id="<%= _id %>" data-title="文章" data-form="<%= JSON.stringify(_cef) %>">编辑</button>
              <button type="button" class="js-admin-delete" data-id="<%= _id %>">删除</button>
            </span></td>
        </tr>
      <% }); %>
      </tbody>
    </table>
    <%- include('../common/adminPager', { url: url, page: page, totalPage: totalPage }) %>
    <% } else { %>
    <%- include('../common/state', { kind:'empty', size:'inline', title:(locals.filters && Object.keys(locals.filters).length > 0) ? '没有符合条件的文章' : '暂无文章', text:(locals.filters && Object.keys(locals.filters).length > 0) ? '试试调整筛选条件或重置' : '' }) %>
    <% } %>
  </div>
</div>
<% } else { %>
<h3>文章管理</h3>
<% if(docs.length > 0){ %>
<table class="table table-hover">
    <thead>
    <tr>
        <th>编号</th>
        <th>标题</th>
        <th>作者</th>
        <th>分类</th>
        <th>发表时间</th>
        <th>修改时间</th>
        <th>状态</th>
        <th>操作</th>
    </tr>
    </thead>
    <tbody>
    <% for(var i = 0;i < docs.length;i++){ %>
    <tr>
        <td><%= i + 1 %></td>
        <td><a href="/content/detail?id=<%= docs[i]._id %>&view=manager/contentDetail"
               title="<%= docs[i].name %>"><%= docs[i].name.length > 10 ? docs[i].name.substring(0, 10) + "..." : docs[i].name %></a>
        </td>
        <td><%- docs[i].realName?docs[i].realName:docs[i].userName %></td>
        <td><%- docs[i].categoryName %></td>
        <td><%= format(docs[i].createTime) %></td>
        <td><%= format(docs[i].modifyTime) %></td>
        <td>
        <%if(session.user._id==docs[i].author || session.user.role == 0){%>
            
            <input type="checkbox" data-id="<%= docs[i]._id %>" data-type="<%= docs[i].status %>"
                   class="js-content-status"/>
        <%}else {%>
            --
        <%}%>
        </td>
        <td>
            <a href="javascript:;" class="js-content-delete" data-id="<%= docs[i]._id %>">删除</a>
        </td>

    </tr>
    <% } %>
    </tbody>
</table>
<%- include('../common/pager') %>
<% }else{ %>
<div class="empty">暂无数据</div>
<% } %>
<% } %>
<%- include('footer') %>
