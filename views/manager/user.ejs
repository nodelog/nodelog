<%- include('header') %>
<ol class="breadcrumb">
    <li><a href="/manager">后台首页</a></li>
    <li class="active">用户管理</li>
</ol>
<% if (typeof filters !== 'undefined') { %>
<% /* 新 /admin SSR 路由：crud.list 注入 filters/sortBy/order；老路由无 filters，走下方原样 legacy UI，role=1 零回归。 */ %>
<% /* 新 SSR decorate 白名单 _id/userName/realName/role/status/createTime/modifyTime/email/phone，绝不含 password。 */ %>
<% /* status：0 正常 / 1 禁用；2 为软删（desc.soft: status<2 已过滤），只能走 delete；batchStatuses 仅 0/1。 */ %>
<% var safeHref = function (u) { u = String(u == null ? '' : u).trim(); return (/^https?:\/\//i.test(u) || /^\/(?!\/)/.test(u)) ? u : '#'; }; %>
<% var _uf = [
     {n:'userName', t:'用户名', k:'text', req:1, max:100},
     {n:'realName', t:'姓名', k:'text', max:100},
     {n:'email', t:'邮箱', k:'text', max:50},
     {n:'phone', t:'手机号', k:'text', max:20},
     {n:'password', t:'新密码（新增必填 8-128 位 / 编辑留空不修改）', k:'text', max:128},
     {n:'role', t:'角色', k:'select', o:[{v:'0',t:'管理员'},{v:'1',t:'普通用户'}], d:'1'},
     {n:'status', t:'状态', k:'select', o:[{v:'0',t:'正常'},{v:'1',t:'禁用'}], d:'0'}
   ]; %>
<h3>用户管理</h3>
<div class="admin-list">
  <%- include('../common/adminToolbar', { bar: {
      res: 'user', base: '/manager/user/admin',
      keyword: true,
      status: [{v:'0',t:'正常'},{v:'1',t:'禁用'}],
      sort: [{v:'createTime',t:'注册时间'},{v:'modifyTime',t:'修改时间'},{v:'userName',t:'用户名'}],
      batch: true, batchStatuses: [{v:'0',t:'正常'},{v:'1',t:'禁用'}],
      io: true,
      add: { label: '新增用户', api: '/manager/user/add', editApi: '/manager/user/update', fields: _uf }
  } }) %>
  <div class="bg-white jumbotron clear-margin">
    <% var _docs = Array.isArray(docs) ? docs : []; %>
    <% if (_docs.length > 0) { %>
    <table class="table table-hover">
      <thead>
      <tr>
        <th class="admin-col-check" aria-label="选择"></th>
        <th>编号</th>
        <th>用户名</th>
        <th>姓名</th>
        <th>邮箱</th>
        <th>手机号</th>
        <th>注册时间</th>
        <th>修改时间</th>
        <th class="admin-col-status">状态</th>
        <th>角色</th>
        <th class="admin-col-actions">操作</th>
      </tr>
      </thead>
      <tbody>
      <% _docs.forEach(function (d, i) { %>
        <% var _id = String(d._id == null ? '' : d._id); %>
        <% var _nm = String(d.userName == null ? '' : d.userName); %>
        <% var _rn = String(d.realName || d.userName || ''); %>
        <% var _st = (d.status === 1 || String(d.status) === '1') ? '1' : '0'; %>
        <% var _stTxt = _st === '1' ? '禁用' : '正常'; %>
        <% var _role = (d.role === 0 || String(d.role) === '0') ? '0' : '1'; %>
        <% var _roleTxt = _role === '0' ? '管理员' : '普通用户'; %>
        <% var _href = safeHref('/manager/user/detail?id=' + _id); %>
        <tr data-id="<%= _id %>" data-userName="<%= _nm %>" data-realName="<%= _rn %>" data-email="<%= d.email || '' %>" data-phone="<%= d.phone || '' %>" data-role="<%= _role %>" data-status="<%= _st %>">
          <td><input type="checkbox" class="js-batch-check" value="<%= _id %>" aria-label="选择 <%= _nm %>"></td>
          <td><%= i + 1 %></td>
          <td><a href="<%= _href %>"><%= _nm %></a></td>
          <td><%= _rn %></td>
          <td><%= d.email || '未设置' %></td>
          <td><%= d.phone || '未设置' %></td>
          <td><%= format(d.createTime) %></td>
          <td><%= format(d.modifyTime) %></td>
          <td><label class="admin-status-toggle">
              <input type="checkbox" class="js-admin-status" data-id="<%= _id %>" data-status="<%= _st %>" <%= _st === '0' ? 'checked' : '' %>>
              <span class="js-status-label"><%= _stTxt %></span>
            </label></td>
          <td><%= _roleTxt %></td>
          <td class="admin-col-actions"><span class="admin-row-actions">
              <a href="<%= _href %>">详情</a>
              <button type="button" class="js-admin-edit" data-id="<%= _id %>" data-title="用户">编辑</button>
              <button type="button" class="js-admin-delete" data-id="<%= _id %>">删除</button>
            </span></td>
        </tr>
      <% }); %>
      </tbody>
    </table>
    <%- include('../common/adminPager', { url: url, page: page, totalPage: totalPage }) %>
    <% } else { %>
    <%- include('../common/state', { kind:'empty', size:'inline', title:(locals.filters && Object.keys(locals.filters).length > 0) ? '没有符合条件的用户' : '暂无用户', text:(locals.filters && Object.keys(locals.filters).length > 0) ? '试试调整筛选条件或重置' : '' }) %>
    <% } %>
  </div>
</div>
<% } else { %>
<h3>用户管理</h3>
<table class="table table-hover">
    <thead>
    <tr>
        <th>编号</th>
        <th>用户名</th>
        <th>姓名</th>
        <th>邮箱</th>
        <th>手机号</th>
        <th>注册时间</th>
        <th>修改时间</th>
        <th>状态</th>
        <th>角色</th>
        <th>操作</th>
    </tr>
    </thead>
    <tbody>
    <tr class="success js-user-edit-panel" style="display: none;">
        <td colspan="10">
            <form action="javascript:;" class="form-horizontal" role="form">
                <div class="input-group" style="width: 100%;">
                    <span class="input-group-addon"><i class="glyphicon glyphicon-user"></i></span>
                    <input type="text" class="form-control js-userName" name="userName" placeholder="用户名" value="<%=session.user.userName%>" maxlength="20"/>
                    <span class="input-group-addon"><i class="glyphicon glyphicon-user"></i></span>
                    <input type="text" class="form-control js-realName" name="realName" placeholder="姓名" value="<%= session.user.realName?session.user.realName:session.user.userName %>"  maxlength="20"/>
                    <span class="input-group-addon"><i class="glyphicon glyphicon-envelope"></i></span>
                    <input type="mail" class="form-control js-email" name="email" placeholder="邮箱" value="<%= session.user.email || '' %>"  maxlength="50"/>
                    <span class="input-group-addon"><i class="glyphicon glyphicon-phone"></i></span>
                    <input type="text" class="form-control js-phone" name="phone" placeholder="手机号（用于微信扫码绑定）" value="<%= session.user.phone || '' %>"  maxlength="20"/>
                    <span class="input-group-addon"><i class="glyphicon glyphicon-lock"></i></span>
                    <input type="password" class="form-control js-password" name="password" placeholder="新密码（留空不修改）" maxlength="20"/>
                    <span class="input-group-addon"><i class="glyphicon glyphicon-hand-right"></i></span>
                    <button type="submit" class="btn btn-primary col-sm-12 col-xs-12 js-user-edit-save">保存</button>
                    <span class="input-group-addon"></span>
                    <button class="btn col-sm-12 col-xs-12 js-user-edit-cancel">取消</button>
                </div>
            </form>
        </td>
    </tr>
    <tr class="success js-current-user">
        <td>1</td>
        <td><%= session.user.userName %></td>
        <td><%= session.user.realName?session.user.realName:session.user.userName%></td>
        <td><%= session.user.email || '未设置' %></td>
        <td><%= session.user.phone || '未设置' %></td>
        <td><%= format(session.user.createTime) %></td>
        <td><%= format(session.user.modifyTime) %></td>
        <td>
            <input type="checkbox" data-id="<%= session.user._id %>" data-type="<%= session.user.status %>"
                   class="js-user-status" disabled="disabled" /></td>
        <td>
            <input type="checkbox" data-id="<%= session.user._id %>" data-type="<%= session.user.role %>"
                   class="js-user-role"disabled="disabled" /></td>
        <td>
            <a href="javascript:;" class="js-user-edit" data-id="<%= session.user._id %>"
               data-user-name="<%= session.user.userName %>"
               data-real-name="<%= session.user.realName?session.user.realName:session.user.userName %>"
               data-email="<%= session.user.email || '' %>"
               data-phone="<%= session.user.phone || '' %>">
                编辑
            </a>
            <a href="javascript:;" class="js-user-delete" data-id="<%= session.user._id %>">删除</a>
        </td>
    </tr>
    <!--管理员-->
    <%
        if (session.user.role==0) {
        var index = 2;//从2开始，1是当前用户
        for(var i = 0;i < docs.length;i++){
        if (docs[i]._id != session.user._id) {
    %>
    <tr>
        <td><%= index++ %></td>
        <td><%= docs[i].userName %></td>
        <td><%= docs[i].realName?docs[i].realName:docs[i].userName%></td>
        <td><%= docs[i].email || '未设置' %></td>
        <td><%= docs[i].phone || '未设置' %></td>
        <td><%= format(docs[i].createTime) %></td>
        <td><%= format(docs[i].modifyTime) %></td>
        <td>
                <input type="checkbox" data-id="<%= docs[i]._id %>" data-type="<%= docs[i].status %>"
                   class="js-user-status" /></td>
        <td>
            <input type="checkbox" data-id="<%= docs[i]._id %>" data-type="<%= docs[i].role %>"
                   class="js-user-role" /></td>
        <td>
                <a href="javascript:;" class="js-user-edit" data-id="<%= docs[i]._id %>"
                   data-user-name="<%= docs[i].userName %>"
                   data-real-name="<%= docs[i].realName?docs[i].realName:docs[i].userName %>"
                   data-email="<%= docs[i].email || '' %>"
                   data-phone="<%= docs[i].phone || '' %>">
                    编辑
                </a>
                <a href="javascript:;" class="js-user-delete" data-id="<%= docs[i]._id %>">删除</a>
        </td>
    </tr>
    <% }}} %>
    </tbody>
</table>
<% if (session.user.role==0) {%>
    <%- include('../common/pager') %>
    <%if (docs.length < 0) {%>
        <div class="empty">暂无数据</div>
    <%}%>
<%}%>
<% } %>
<%- include('footer') %>
