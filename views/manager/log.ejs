<%- include('header') %>
<ol class="breadcrumb">
    <li><a href="/manager">后台首页</a></li>
    <li class="active">公告管理</li>
</ol>
<h3>公告管理
    <a href="/manager/log/addPage" class="btn btn-primary pull-right">发布公告</a>
</h3>

<div class="clearfix"></div>
<% if(docs.length > 0){ %>
<table class="table table-hover">
    <thead>
    <tr>
        <th>编号</th>
        <th>标题</th>
        <th>发布时间</th>
        <th>修改时间</th>
        <th>操作</th>
    </tr>
    </thead>
    <tbody>
    <% for(var i = 0;i < docs.length;i++){ %>
    <tr>
        <td><%= i + 1 %></td>
        <td><a href="/manager/log/detail?id=<%= docs[i]._id %>&view=manager/logDetail" data-id="<%= docs[i]._id %>"><%= docs[i].name %></a></td>
        <td><%= format(docs[i].createTime) %></td>
        <td><%= format(docs[i].modifyTime) %></td>
        <td><a href="javascript:;" class="js-log-delete" data-id="<%= docs[i]._id %>">删除</a></td>
    </tr>
    <% } %>
    </tbody>
</table>
<%- include('../common/pager') %>
<% }else{ %>
<div class="empty">暂无数据</div>
<% } %>
<%- include('footer') %>
