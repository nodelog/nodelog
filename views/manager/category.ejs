<%- include('header') %>
<ol class="breadcrumb">
    <li><a href="/manager">后台首页</a></li>
    <li class="active">分类管理</li>
</ol>
<% if (typeof filters !== 'undefined') { %>
<% /* 新 /admin SSR 路由；老路由保持下方 legacy UI，role=1 零回归。 */ %>
<% var safeHref = function (u) { u = String(u == null ? '' : u).trim(); return (/^https?:\/\//i.test(u) || /^\/(?!\/)/.test(u)) ? u : '#'; }; %>
<h3>分类管理</h3>
<div class="admin-list">
  <%- include('../common/adminToolbar', { bar: {
      res: 'category', base: '/manager/category/admin',
      keyword: true,
      status: [{v:'0',t:'正常'},{v:'1',t:'禁用'}],
      sort: [{v:'order',t:'排序'},{v:'name',t:'名称'},{v:'createTime',t:'创建时间'}],
      batch: true, batchStatuses: [{v:'0',t:'正常'},{v:'1',t:'禁用'}],
      io: true,
      add: { label: '新增分类', api: '/manager/category/add', editApi: '/manager/category/modify', fields: [
        {n:'name', t:'名称', k:'text', req:1, max:60},
        {n:'slug', t:'标识', k:'text', max:60},
        {n:'keywords', t:'触发词(逗号分隔,用于自动分类)', k:'text', max:200},
        {n:'order', t:'排序', k:'text', max:12, d:'0'}
      ]}
  } }) %>
  <div class="bg-white jumbotron clear-margin">
    <% var _docs = Array.isArray(docs) ? docs : []; %>
    <% if (_docs.length > 0) { %>
    <table class="table table-hover">
      <thead>
      <tr>
        <th class="admin-col-check" aria-label="选择"></th>
        <th>编号</th>
        <th>名称</th>
        <th>触发词</th>
        <th>标识</th>
        <th>排序</th>
        <th>创建时间</th>
        <th>修改时间</th>
        <th class="admin-col-status">状态</th>
        <th class="admin-col-actions">操作</th>
      </tr>
      </thead>
      <tbody>
      <% _docs.forEach(function (d, i) { %>
        <% var _id = String(d._id == null ? '' : d._id); %>
        <% var _nm = String(d.name == null ? '' : d.name); %>
        <% var _st = (d.status === 1 || String(d.status) === '1') ? '1' : '0'; %>
        <% var _stTxt = _st === '1' ? '禁用' : '正常'; %>
        <% var _href = safeHref('/manager/category/detail?id=' + _id); %>
        <tr data-id="<%= _id %>" data-name="<%= _nm %>" data-slug="<%= d.slug || '' %>" data-order="<%= d.order == null ? 0 : d.order %>" data-keywords="<%= d.keywords || '' %>" data-status="<%= _st %>">
          <td><input type="checkbox" class="js-batch-check" value="<%= _id %>" aria-label="选择 <%= _nm %>"></td>
          <td><%= i + 1 %></td>
        <td><a href="<%= _href %>"><%= _nm %></a></td>
        <td><%= d.keywords || '' %></td>
        <td><%= d.slug || '' %></td>
          <td><%= d.order == null ? 0 : d.order %></td>
          <td><%= format(d.createTime) %></td>
          <td><%= format(d.modifyTime) %></td>
          <td><label class="admin-status-toggle">
              <input type="checkbox" class="js-admin-status" data-id="<%= _id %>" data-status="<%= _st %>" <%= _st === '0' ? 'checked' : '' %>>
              <span class="js-status-label"><%= _stTxt %></span>
            </label></td>
          <td class="admin-col-actions"><span class="admin-row-actions">
              <a href="<%= _href %>">详情</a>
              <button type="button" class="js-admin-edit" data-id="<%= _id %>" data-title="分类">编辑</button>
              <button type="button" class="js-admin-delete" data-id="<%= _id %>">删除</button>
            </span></td>
        </tr>
      <% }); %>
      </tbody>
    </table>
    <%- include('../common/adminPager', { url: url, page: page, totalPage: totalPage }) %>
    <% } else { %>
    <%- include('../common/state', { kind:'empty', size:'inline', title:(locals.filters && Object.keys(locals.filters).length > 0) ? '没有符合条件的分类' : '暂无分类', text:(locals.filters && Object.keys(locals.filters).length > 0) ? '试试调整筛选条件或重置' : '' }) %>
    <% } %>
  </div>
</div>
<% } else { %>
<h3> 分类管理
    <button type="button" class="btn btn-default pull-right js-add-category">
        <i class="glyphicon glyphicon-plus"></i>&nbsp; 新增分类
    </button>
</h3>

<div class="clearfix"></div>
<% if(docs.length > 0){ %>
<table class="table table-hover">
    <thead>
    <tr>
        <th>编号</th>
        <th>名称</th>
        <th>创建时间</th>
        <th>修改时间</th>
        <th>操作</th>
    </tr>
    </thead>
    <tbody>
    <% for(var i = 0;i < docs.length;i++){ %>
    <tr>
        <td><%= i + 1 %></td>
        <td><a href="javascript:;" data-id="<%= docs[i]._id %>" class="js-modify-category"
               title="点击修改分类"><%= docs[i].name %></a></td>
        <td><%= format(docs[i].createTime) %></td>
        <td><%= format(docs[i].modifyTime) %></td>
        <td><a href="javascript:;" class="js-category-delete" data-id="<%= docs[i]._id %>">删除</a></td>
    </tr>
    <% } %>
    </tbody>
</table>
<%- include('../common/pager') %>
<% }else{ %>
<div class="empty">暂无数据</div>
<% } %>
<div class="hide">
    <div class="js-add-category-panel">
        <i class="icon-remove fixed-right-top size-40 padding-15 pointer opacity-03 hover-opacity-1 layer-close-all"></i>
        <div class="page-header">
            <h1 class="text-center">添加/修改分类</h1>
        </div>
        <form action="javascript:;" class="form-horizontal l-login-panel" role="form">
            <div class="input-group">
                <span class="input-group-addon">分类名称</span>
                <input type="text" class="form-control js-category-name" value="" placeholder="输入分类名称" maxlength="20"/>
            </div>
            <div class="form-group">
                <div class="col-sm-12 l-padding-vertical">
                    <button type="submit" class="btn btn-primary col-sm-12 js-save-category">保存</button>
                </div>
            </div>
        </form>
    </div>
</div>
<% } %>
<%- include('footer') %>
