<%- include('header') %>
<p class="kicker">最新文章 · <%= total %> 篇</p>

<div class="layout">
    <div class="layout-main">
        <% if (typeof docs !== 'undefined' && docs && docs.length) { %>
        <div class="post-grid">
            <% docs.forEach(function(doc, i){ %>
                <%- include('common/postCard', { doc: doc, variant: i === 0 ? 'lead' : 'grid' }) %>
            <% }); %>
        </div>
        <% } else { %>
        <h1 class="sr-only">最新文章</h1>
        <%- include('common/state', { kind: 'empty', size: 'block', title: '还没有文章', text: '发布第一篇文章后，这里会显示文章列表', actionHref: '/content/addPage', actionText: '去写第一篇' }) %>
        <% } %>

        <%- include('common/pagination', { page: page, totalPage: totalPage, url: (typeof locals.url === 'string' && locals.url) ? locals.url : '/index?' }) %>
    </div>

    <%- include('common/sidebar') %>
</div>
<input type="hidden" class="js-login-flag" value="<%=login%>"/>
<%- include('footer') %>
