<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <%- include('common/meta-front') %>
</head>
<body class="js-body">
<a class="skip-link" href="#main">跳到主内容</a>
<% var zones = navConfig.front.zones; %>
<% var displayName = session.user ? (session.user.realName ? session.user.realName : session.user.userName) : ''; %>
<header class="site-header">
<nav class="navbar nav-bg bottom-border" role="navigation" aria-label="主导航">
    <div class="navbar-header">
        <!-- 常规顺序：品牌 logo + 站名在左，汉堡在右（两端对齐） -->
        <a class="navbar-brand" href="/">
            <span class="brand-mark-sq"><%= (session.site.name || 'N').charAt(0) %></span>
            <span class="brand-name"><%=session.site.name %></span>
            <span class="blog-tag">BLOG</span>
        </a>
        <button type="button" class="navbar-toggle" data-toggle="collapse" data-target="#example-navbar-collapse" aria-controls="example-navbar-collapse" aria-expanded="false">
            <span class="sr-only">展开导航</span>
            <span class="icon-bar"></span>
            <span class="icon-bar"></span>
            <span class="icon-bar"></span>
        </button>
    </div>
    <div class="collapse navbar-collapse" id="example-navbar-collapse">
        <!-- 区一：内容导航——只放"去哪里"，紧贴品牌 -->
        <ul class="nav navbar-nav nav-primary" aria-label="内容导航">
            <% zones.primary.forEach(function(item){ %>
            <% var active = navConfig.isCurrent(item, locals.currentMenu); %>
            <% if(item.type === "dropdown"){ %>
            <li class="dropdown js-category">
                <a title="<%= item.title %>" class="dropdown-toggle color-white <%= item.className %> <%if(active){%>current-menu<%}%>" <%if(active){%>aria-current="page"<%}%> data-nav-toggle data-toggle="dropdown" href="javascript:;" role="button" tabindex="0" aria-haspopup="true" aria-expanded="false"><%= item.label %> <svg class="nav-caret" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></a>
                <ul class="dropdown-menu l-select js-category-menu" role="menu" aria-label="分类列表">
                    <li class="js-category-fallback"><a class="l-option" href="/" title="分类列表需启用 JavaScript，此处可回首页浏览全部文章">全部文章</a></li>
                </ul>
            </li>
            <% }else{ %>
            <li>
                <a href="<%= item.href %>" title="<%= item.title %>" class="color-white <%= item.className %> <%= active ? 'current-menu' : '' %>" <%= active ? 'aria-current="page"' : '' %>
                   <% if (item.target) { %>target="<%= item.target %>" rel="noopener noreferrer"<% } %> ><%= item.label %><%if(item.badge){%> <span class="badge js-log-count"></span><%}%></a>
            </li>
            <% } %>
            <% }); %>
        </ul>

        <!-- 区二：工具栏——搜索（图标）/ 主题，右侧留白隔开 -->
        <ul class="nav navbar-nav nav-tools" aria-label="工具栏">
            <li class="nav-search-toggle">
                <button type="button" id="nlSearchToggle" class="icon-btn" aria-label="搜索文章" aria-expanded="false" aria-keyshortcuts="Control+K Meta+K" title="搜索文章 (Ctrl+K)">
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
                </button>
            </li>
            <li>
                <button class="icon-btn theme-toggle" id="themeToggle" title="切换深色/浅色" aria-label="切换深色/浅色"
                        onclick="(function(){var r=document.documentElement;var c=r.getAttribute('data-theme');var n=c==='dark'?'light':'dark';r.setAttribute('data-theme',n);try{localStorage.setItem('nl-theme',n);}catch(e){}})()"><span class="theme-icon" aria-hidden="true"><svg class="i-moon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5z"/></svg><svg class="i-sun" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M19.1 4.9l-1.4 1.4M6.3 17.7l-1.4 1.4"/></svg></span></button>
            </li>
        </ul>

        <!-- 区三：账号域——登录 / 用户菜单 / 写文章，收进右侧作为一个整体 -->
        <ul class="nav navbar-nav nav-account-zone" aria-label="账号与创作">
            <% if(session.user == null){ %>
            <li class="js-login-toggle js-when-logged-out"><a href="javascript:;" role="button" tabindex="0" title="扫码登录" class="js-login-btn nav-login">登录</a></li>
            <% } else { %>
            <% zones.cta.forEach(function(item){ %>
            <li><a href="<%= item.href %>" title="<%= item.title %>" class="btn btn-primary nav-cta <%= item.className %>"><svg class="nav-cta-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg><%= item.label %></a></li>
            <% }); %>
            <li class="dropdown nav-account js-login-toggle js-when-logged-in">
                <a href="javascript:;" role="button" tabindex="0" data-nav-toggle class="nav-account-toggle" aria-label="账号菜单" aria-haspopup="true" aria-expanded="false"><span class="account-avatar"><%= displayName.charAt(0) %></span><span class="nav-account-name"><%= displayName %></span> <svg class="nav-caret" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></a>
                <ul class="dropdown-menu dropdown-menu--right" role="menu" aria-label="账号菜单">
                    <li class="nav-account-head"><span><%= displayName %></span></li>
                    <% zones.account.forEach(function(item){ %>
                    <% if(item.type === "action"){ %>
                    <li><a href="javascript:;" role="button" tabindex="0" class="<%= item.className %>"><%= item.label %></a></li>
                    <% }else{ %>
                    <li><a href="<%= item.href %>" title="<%= item.title %>" class="<%= item.className %>"><%= item.label %></a></li>
                    <% } %>
                    <% }); %>
                </ul>
            </li>
            <% } %>
        </ul>
    </div>
</nav>
<!-- 搜索浮层：点击放大镜展开，输入实时出建议，Esc / 点 X 收起 -->
<div class="nav-search-panel js-search-bar" id="nlSearchPanel" hidden>
    <div class="nav-search-inner">
        <svg class="nav-search-icon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
        <input type="search" id="nl-site-search" maxlength="50" class="nav-search-input js-search"
               value="<%if(locals.key){%><%=key%><%}%>" placeholder="搜索文章标题、标签或内容…"
               role="searchbox" aria-label="搜索文章" aria-autocomplete="list" aria-controls="nl-search-suggest" autocomplete="off"/>
        <button type="button" class="icon-btn nav-search-close" id="nlSearchClose" aria-label="关闭搜索">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
        </button>
        <ul class="dropdown-menu l-search-select hide js-search-panel" id="nl-search-suggest" role="menu" aria-label="搜索建议" aria-live="polite"></ul>
    </div>
</div>
</header>
<div class="container page-shell">
    <main id="main" tabindex="-1">
