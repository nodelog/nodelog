<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <%- include('common/meta-front') %>
</head>
<body class="bg-gray js-body">
<a class="skip-link" href="#main">跳到主内容</a>
<header class="site-header">
<nav class="navbar nav-bg navbar-fixed-top bottom-border" role="navigation" aria-label="主导航">
    <div class="navbar-header">
        <button type="button" class="navbar-toggle" data-toggle="collapse" data-target="#example-navbar-collapse" aria-controls="example-navbar-collapse" aria-expanded="false">
            <span class="sr-only">展开导航</span>
            <span class="icon-bar"></span>
            <span class="icon-bar"></span>
            <span class="icon-bar"></span>
        </button>
        <a class="navbar-brand" href="/"><%=session.site.name %></a>
    </div>
    <div class="collapse navbar-collapse" id="example-navbar-collapse">
        <ul class="nav navbar-nav">
            <li>
                <a href="/" title="首页" class="color-white js-home-menu <%if((!locals.currentMenu)||currentMenu=="home"){%>current-menu<%}%>" <%if((!locals.currentMenu)||currentMenu=="home"){%>aria-current="page"<%}%>>首页</a>
            </li>
            <li class="dropdown js-category">
                <a title="按分类浏览" class="dropdown-toggle color-white js-category-content <%if(locals.currentMenu&&currentMenu=="category"){%>current-menu<%}%>" <%if(locals.currentMenu&&currentMenu=="category"){%>aria-current="page"<%}%> data-toggle="dropdown" href="javascript:;" role="button" aria-haspopup="true" aria-expanded="false">分类 <svg class="nav-caret" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></a>
                <ul class="dropdown-menu l-select js-category-menu" role="menu" aria-label="分类列表"></ul>
            </li>
            <li>
                <a href="/content/addPage?view=addContent" title="写文章" class="color-white js-post-log <%if(locals.currentMenu&&currentMenu=="content"){%>current-menu<%}%>" <%if(locals.currentMenu&&currentMenu=="content"){%>aria-current="page"<%}%>>写文章</a>
            </li>
            <li>
                <a href="javascript:;" title="我发表的文章" role="button" class="color-white js-my-content-menu <%if(locals.currentMenu&&currentMenu=="mycontent"){%>current-menu<%}%>" <%if(locals.currentMenu&&currentMenu=="mycontent"){%>aria-current="page"<%}%>>我的文章</a>
            </li>
            <li>
                <a href="/log?view=log&page=1" title="系统公告" class="color-white badge-father js-log <%if(locals.currentMenu&&currentMenu=="log"){%>current-menu<%}%>" <%if(locals.currentMenu&&currentMenu=="log"){%>aria-current="page"<%}%>>公告 <span class="badge js-log-count"></span></a>
            </li>
            <% if(session.user != null){ %>
            <li class="js-login-toggle">
                <a href="javascript:;" class="js-login-btn color-white" role="button" style="display: none;">登录</a>
                <a href="/manager" title="后台管理" class="color-white"><%= session.user.realName ? session.user.realName : session.user.userName %></a>
            </li>
            <li class="js-login-toggle">
                <a href="javascript:;" class="js-register-btn color-white" role="button" style="display: none;">注册</a>
                <a href="javascript:;" title="退出登录" role="button" class="color-white js-logout-btn">退出</a>
            </li>
            <% }else{ %>
            <li class="js-login-toggle">
                <a href="javascript:;" title="扫码登录" class="js-login-btn color-white" role="button">扫码登录</a>
                <a href="/manager" class="color-white" style="display: none;"><span class="js-user-name"></span></a>
            </li>
            <li class="js-login-toggle">
                <a href="javascript:;" title="注册" class="js-register-btn color-white" role="button">注册</a>
                <a href="javascript:;" role="button" class="color-white js-logout-btn" style="display: none;">退出</a>
            </li>
            <% } %>
            <li class="dropdown js-search-bar search-bar">
                <input type="search" id="nl-site-search" data-toggle="dropdown" maxlength="50"
                       class="dropdown-toggle form-control search-input js-search"
                       value="<%if(locals.key){%><%=key%><%}%>" placeholder="搜索文章"
                       role="searchbox" aria-label="搜索文章" aria-autocomplete="list" aria-controls="nl-search-suggest"/>
                <ul class="dropdown-menu l-search-select hide js-search-panel" id="nl-search-suggest" role="menu" aria-label="搜索建议" aria-live="polite"></ul>
            </li>
            <li>
                <button class="theme-toggle" id="themeToggle" title="切换深色/浅色" aria-label="切换深色/浅色"
                        onclick="(function(){var r=document.documentElement;var c=r.getAttribute('data-theme');var n=c==='dark'?'light':'dark';r.setAttribute('data-theme',n);try{localStorage.setItem('nl-theme',n);}catch(e){}})()"><span class="theme-icon" aria-hidden="true"><svg class="i-moon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5z"/></svg><svg class="i-sun" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M19.1 4.9l-1.4 1.4M6.3 17.7l-1.4 1.4"/></svg></span></button>
            </li>
        </ul>
    </div>
</nav>
</header>
<div class="container page-shell">
    <main id="main" tabindex="-1">
