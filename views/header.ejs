<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <%- include('common/meta') %>
</head>
<body class="bg-gray js-body">
<nav class="navbar nav-bg navbar-fixed-top bottom-border" role="navigation">
    <div class="navbar-header">
        <button type="button" class="navbar-toggle" data-toggle="collapse" data-target="#example-navbar-collapse">
            <span class="sr-only">展开导航</span>
            <span class="icon-bar"></span>
            <span class="icon-bar"></span>
            <span class="icon-bar"></span>
        </button>
        <a class="navbar-brand" href="/"><%=session.site.name %></a>
    </div>
    <div class="collapse navbar-collapse" id="example-navbar-collapse">
        <ul class="nav navbar-nav">
            <li>
                <a href="/" title="首页" class="color-white js-home-menu <%if((!locals.currentMenu)||currentMenu=="home"){%>current-menu<%}%>">首页</a>
            </li>
            <li class="dropdown js-category">
                <a title="按分类浏览" class="dropdown-toggle color-white js-category-content <%if(locals.currentMenu&&currentMenu=="category"){%>current-menu<%}%>" data-toggle="dropdown" href="javascript:;">分类 <i class="glyphicon glyphicon-chevron-down"></i></a>
                <ul class="dropdown-menu l-select js-category-menu" role="menu"></ul>
            </li>
            <li>
                <a href="/content/addPage?view=addContent" title="写文章" class="color-white js-post-log <%if(locals.currentMenu&&currentMenu=="content"){%>current-menu<%}%>">写文章</a>
            </li>
            <li>
                <a href="javascript:;" title="我发表的文章" class="color-white js-my-content-menu <%if(locals.currentMenu&&currentMenu=="mycontent"){%>current-menu<%}%>">我的文章</a>
            </li>
            <li>
                <a href="/log?view=log&page=1" title="系统公告" class="color-white badge-father js-log <%if(locals.currentMenu&&currentMenu=="log"){%>current-menu<%}%>">公告 <span class="badge js-log-count"></span></a>
            </li>
            <% if(session.user != null){ %>
            <li class="js-login-toggle">
                <a href="javascript:;" class="js-login-btn color-white" style="display: none;">登录</a>
                <a href="/manager" title="后台管理" class="color-white"><%= session.user.realName ? session.user.realName : session.user.userName %></a>
            </li>
            <li class="js-login-toggle">
                <a href="javascript:;" class="js-register-btn color-white" style="display: none;">注册</a>
                <a href="javascript:;" title="退出登录" class="color-white js-logout-btn">退出</a>
            </li>
            <% }else{ %>
            <li class="js-login-toggle">
                <a href="javascript:;" title="登录" class="js-login-btn color-white">登录</a>
                <a href="/manager" class="color-white" style="display: none;"><span class="js-user-name"></span></a>
            </li>
            <li class="js-login-toggle">
                <a href="javascript:;" title="注册" class="js-register-btn color-white">注册</a>
                <a href="javascript:;" class="color-white js-logout-btn" style="display: none;">退出</a>
            </li>
            <% } %>
            <li class="dropdown js-search-bar search-bar">
                <input type="search" data-toggle="dropdown" maxlength="50"
                       class="dropdown-toggle form-control search-input js-search"
                       value="<%if(locals.key){%><%=key%><%}%>" placeholder="搜索文章" aria-label="搜索文章"/>
                <ul class="dropdown-menu l-search-select hide js-search-panel" role="menu"></ul>
            </li>
            <li>
                <button class="theme-toggle" id="themeToggle" title="切换深色/浅色" aria-label="切换深色/浅色"
                        onclick="(function(){var r=document.documentElement;var c=r.getAttribute('data-theme');var n=c==='dark'?'light':'dark';r.setAttribute('data-theme',n);try{localStorage.setItem('nl-theme',n);}catch(e){}})()"><span class="theme-icon" aria-hidden="true"></span></button>
            </li>
        </ul>
    </div>
</nav>
<div class="container page-shell">
    <article>
