<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <%- include('common/meta-front') %>
</head>
<body class="bg-gray js-body">
<a class="skip-link" href="#main">跳到主内容</a>
<header class="site-header">
<nav class="navbar nav-bg bottom-border" role="navigation" aria-label="主导航">
    <div class="navbar-header">
        <button type="button" class="navbar-toggle" data-toggle="collapse" data-target="#example-navbar-collapse" aria-controls="example-navbar-collapse" aria-expanded="false">
            <span class="sr-only">展开导航</span>
            <span class="icon-bar"></span>
            <span class="icon-bar"></span>
            <span class="icon-bar"></span>
        </button>
        <a class="navbar-brand" href="/"><%=session.site.name %></a>
    </div>
    <div class="collapse navbar-collapse" id="example-navbar-collapse">
        <ul class="nav navbar-nav">
            <% navConfig.front.groups.forEach(function(group){ %>
            <% group.items.forEach(function(item){ %>
            <% var active = navConfig.isCurrent(item, locals.currentMenu); %>
            <% if(item.type === "dropdown"){ %>
            <li class="dropdown js-category">
                <a title="<%= item.title %>" class="dropdown-toggle color-white <%= item.className %> <%if(active){%>current-menu<%}%>" <%if(active){%>aria-current="page"<%}%> data-toggle="dropdown" href="javascript:;" role="button" aria-haspopup="true" aria-expanded="false"><%= item.label %> <svg class="nav-caret" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></a>
                <ul class="dropdown-menu l-select js-category-menu" role="menu" aria-label="分类列表">
                    <li class="js-category-fallback"><a class="l-option" href="/" title="分类列表需启用 JavaScript，此处可回首页浏览全部文章">全部文章</a></li>
                </ul>
            </li>
            <% }else{ %>
            <li>
                <a href="<%= item.href %>" title="<%= item.title %>" class="color-white <%= item.className %> <%if(active){%>current-menu<%}%>" <%if(active){%>aria-current="page"<%}%>><%= item.label %><%if(item.badge){%> <span class="badge js-log-count"></span><%}%></a>
            </li>
            <% } %>
            <% }); %>
            <% }); %>
            <% if(session.user != null){ %>
            <li class="js-login-toggle">
                <a href="javascript:;" class="js-login-btn color-white" role="button" tabindex="0" style="display: none;">登录</a>
                <a href="/manager" title="后台管理" class="color-white" aria-label="后台管理"><%= session.user.realName ? session.user.realName : session.user.userName %></a>
            </li>
            <li class="js-login-toggle">
                <a href="javascript:;" title="退出登录" role="button" tabindex="0" class="color-white js-logout-btn">退出</a>
            </li>
            <% }else{ %>
            <li class="js-login-toggle">
                <a href="javascript:;" title="扫码登录" class="js-login-btn color-white" role="button" tabindex="0">扫码登录</a>
                <a href="/manager" class="color-white" style="display: none;"><span class="js-user-name"></span></a>
            </li>
            <li class="js-login-toggle">
                <a href="javascript:;" role="button" tabindex="0" class="color-white js-logout-btn" style="display: none;">退出</a>
            </li>
            <% } %>
            <li class="dropdown js-search-bar search-bar">
                <input type="search" id="nl-site-search" data-toggle="dropdown" maxlength="50"
                       class="dropdown-toggle form-control search-input js-search"
                       value="<%if(locals.key){%><%=key%><%}%>" placeholder="搜索文章"
                       role="searchbox" aria-label="搜索文章" aria-autocomplete="list" aria-controls="nl-search-suggest"/>
                <ul class="dropdown-menu l-search-select hide js-search-panel" id="nl-search-suggest" role="menu" aria-label="搜索建议" aria-live="polite"></ul>
            </li>
            <li>
                <button class="theme-toggle" id="themeToggle" title="切换深色/浅色" aria-label="切换深色/浅色"
                        onclick="(function(){var r=document.documentElement;var c=r.getAttribute('data-theme');var n=c==='dark'?'light':'dark';r.setAttribute('data-theme',n);try{localStorage.setItem('nl-theme',n);}catch(e){}})()"><span class="theme-icon" aria-hidden="true"><svg class="i-moon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5z"/></svg><svg class="i-sun" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M19.1 4.9l-1.4 1.4M6.3 17.7l-1.4 1.4"/></svg></span></button>
            </li>
        </ul>
    </div>
</nav>
</header>
<div class="container page-shell">
    <main id="main" tabindex="-1">
