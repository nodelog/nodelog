<script>
(function () {
    /* 代码块一键复制：navigator.clipboard 优先，失败降级 execCommand */
    var buttons = Array.prototype.slice.call(document.querySelectorAll('[data-copy]'));
    function flash(btn, text, copied) {
        btn.textContent = text;
        btn.classList.toggle('is-copied', !!copied);
        if (btn._t) clearTimeout(btn._t);
        btn._t = setTimeout(function () {
            btn.textContent = '复制';
            btn.classList.remove('is-copied');
        }, 1800);
    }
    function fallback(text) {
        var ta = document.createElement('textarea');
        ta.value = text;
        ta.setAttribute('readonly', '');
        ta.style.position = 'fixed';
        ta.style.top = '-1000px';
        document.body.appendChild(ta);
        ta.select();
        var ok = false;
        try { ok = document.execCommand('copy'); } catch (e) { ok = false; }
        document.body.removeChild(ta);
        return ok;
    }
    buttons.forEach(function (btn) {
        btn.addEventListener('click', function () {
            var box = btn.closest('.op-code');
            var code = box && box.querySelector('code');
            if (!code) return;
            var text = code.textContent;
            if (navigator.clipboard && navigator.clipboard.writeText) {
                navigator.clipboard.writeText(text).then(function () {
                    flash(btn, '已复制', true);
                }).catch(function () {
                    var ok = fallback(text);
                    flash(btn, ok ? '已复制' : '复制失败', ok);
                });
            } else {
                var ok = fallback(text);
                flash(btn, ok ? '已复制' : '复制失败', ok);
            }
        });
    });

    /* 目录滚动高亮：rAF 节流的 scroll 监听，无动画、reduced-motion 下同样可用 */
    var links = Array.prototype.slice.call(document.querySelectorAll('.op-toc a[href^="#"]'));
    var sections = links.map(function (a) {
        return document.getElementById(a.getAttribute('href').slice(1));
    }).filter(Boolean);
    if (!sections.length) return;
    function activate(id) {
        links.forEach(function (a) {
            var on = a.getAttribute('href') === '#' + id;
            a.classList.toggle('is-active', on);
            if (on) a.setAttribute('aria-current', 'location');
            else a.removeAttribute('aria-current');
        });
    }
    function update() {
        var y = window.pageYOffset || document.documentElement.scrollTop || 0;
        var line = y + 128;
        var current = sections[0];
        for (var i = 0; i < sections.length; i++) {
            var rect = sections[i].getBoundingClientRect();
            if (rect.top + y <= line) current = sections[i];
        }
        if (current) activate(current.id);
    }
    var ticking = false;
    window.addEventListener('scroll', function () {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(function () { update(); ticking = false; });
    }, { passive: true });
    window.addEventListener('resize', update);
    update();
})();
</script>

