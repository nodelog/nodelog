<%- include('header') %>
<% if (doc != null) { %>
<ol class="breadcrumb">
    <li><a href="/" title="首页">首页</a></li>
    <li><a href="/log?page=1&view=log">系统公告</a></li>
    <li class="active">正文</li>
</ol>
<h1><%= doc.name %></h1>
<div class="article-meta"><span><%= format(doc.createTime, "YYYY-MM-DD") %></span></div>
<div class="card article-body article-content"><%- doc.content %></div>
<% } else { %>
<div class="empty"><span class="empty-title">公告不存在</span>它可能已被删除。</div>
<% } %>
<input type="hidden" class="js-current-menu" value="js-log"/>
<%- include('footer') %>
