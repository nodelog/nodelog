<% if (typeof docs !== 'undefined' && docs && docs.length) { %>
<div class="post-grid">
    <% docs.forEach(function(doc){ %>
        <%- include('common/postCard', { doc: doc }) %>
    <% }); %>
</div>
<% if (totalPage > 1) { %>
<div class="pager">
    <% for (var p = 1; p <= totalPage; p++) { %>
        <% if (p === page) { %><span class="current"><%= p %></span><% } else { %><a href="<%= url %>page=<%= p %>"><%= p %></a><% } %>
    <% } %>
</div>
<% } %>
<% } else { %>
<div class="card">暂无内容</div>
<% } %>
