<%
  var edContent = '';
  if (typeof(doc) !== 'undefined' && doc && doc.content) edContent = doc.content;
  else if (typeof(template) !== 'undefined' && template) edContent = template;
%>
<% if (typeof(doc) !== 'undefined' && doc && doc.htmlBackup) { %>
<div class="alert">这篇是旧版富文本文章，已自动转换为 Markdown 显示。检查排版后点「保存修改」即完成转换；原始 HTML 会一并留档，可随时回滚。未保存前文章页仍按原格式展示。</div>
<% } %>
<div class="md-editor panel panel-default">
  <div class="md-toolbar btn-toolbar panel-heading" role="toolbar" aria-label="Markdown 编辑器工具栏">
    <div class="btn-group btn-group-sm">
      <button type="button" class="btn btn-default" data-md="bold" title="加粗"><i class="icon-bold"></i></button>
      <button type="button" class="btn btn-default" data-md="italic" title="斜体"><i class="icon-italic"></i></button>
      <button type="button" class="btn btn-default" data-md="heading" title="标题"><i class="icon-text-height"></i></button>
    </div>
    <div class="btn-group btn-group-sm">
      <button type="button" class="btn btn-default" data-md="link" title="链接"><i class="icon-link"></i></button>
      <button type="button" class="btn btn-default" data-md="quote" title="引用"><i class="icon-quote-left"></i></button>
      <button type="button" class="btn btn-default" data-md="code" title="行内代码"><i class="icon-code"></i></button>
      <button type="button" class="btn btn-default" data-md="ul" title="无序列表"><i class="icon-list-ul"></i></button>
      <button type="button" class="btn btn-default" data-md="ol" title="有序列表"><i class="icon-list-ol"></i></button>
    </div>
    <div class="btn-group btn-group-sm">
      <button type="button" class="btn btn-default js-md-img" title="上传并插入图片"><i class="icon-picture"></i> 图片</button>
      <input type="file" class="js-md-file hide" accept="image/*">
      <button type="button" class="btn btn-default js-md-preview" title="实时预览"><i class="icon-eye-open"></i> 预览</button>
    </div>
    <span class="md-hint text-muted hidden-xs"><i class="icon-info-sign"></i> 支持 Markdown · 草稿自动存本地</span>
  </div>
  <div class="md-body panel-body">
    <textarea class="js-editor form-control md-input" id="editor" placeholder="开始书写，支持 Markdown 语法（# 标题、**加粗**、- 列表、![](图片) …）"><%= edContent %></textarea>
    <div class="md-preview markdown-body hide"><div class="js-md-preview-body markdown-body"></div></div>
  </div>
</div>
