<%- include('header') %>
<ol class="breadcrumb" aria-label="面包屑">
    <li><a href="/">首页</a></li>
    <li class="active" aria-current="page">标签</li>
</ol>
<div class="page-head">
    <h1># <%= tag.name %></h1>
    <p class="kicker">共 <%= total %> 篇</p>
</div>

<% if (docs && docs.length) { %>
<div class="post-list">
    <% docs.forEach(function(doc){ %>
        <%- include('common/postCard', { doc: doc, variant: 'list' }) %>
    <% }); %>
</div>
<%- include('common/pagination', { page: page, totalPage: totalPage, url: (typeof locals.url === 'string' && locals.url) ? locals.url : '/tag/' + encodeURIComponent(tag.name) + '?' }) %>
<% } else { %>
<%- include('common/state', { kind: 'empty', size: 'block', title: '这个标签下还没有文章', text: '回首页看看最新文章', actionHref: '/', actionText: '回首页' }) %>
<% } %>
<%- include('footer') %>
