<%- include('header') %>
<div class="page-head">
    <h1># <%= tag.name %></h1>
    <p class="muted">共 <%= total %> 篇</p>
</div>

<% if (docs && docs.length) { %>
<div class="post-grid">
    <% docs.forEach(function(doc){ %>
        <%- include('common/postCard', { doc: doc }) %>
    <% }); %>
</div>
<% if (totalPage > 1) { %>
<div class="pager">
    <% for (var p = 1; p <= totalPage; p++) { %>
        <% if (p === page) { %><span class="current"><%= p %></span><% } else { %><a href="<%= url %>page=<%= p %>"><%= p %></a><% } %>
    <% } %>
</div>
<% } %>
<% } else { %>
<div class="empty"><span class="empty-title">没有找到文章</span>试试其他分类或关键词。</div>
<% } %>
<%- include('footer') %>
