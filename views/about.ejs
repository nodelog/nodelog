<%- include('header') %>
<div class="layout">
    <div class="layout-main">
        <ol class="breadcrumb" aria-label="面包屑">
            <li><a href="/">首页</a></li>
            <li class="active" aria-current="page">关于本站</li>
        </ol>
        <div class="page-head">
            <h1>关于本站</h1>
            <p class="kicker"><%=session.site.name%></p>
        </div>
        <div class="card article-content">
            <p><%=session.site.name%> 是链付收银SAAS 的官方博客，记录产品演进、商业观察与开发实践。</p>
            <p>支持 Markdown 写作、全文检索，以及按分类浏览文章。</p>

            <h2>源码授权</h2>
            <p>本站基于 NODELOG 源码搭建。若你希望将其用于商业站点或私有化部署，
               请查看<a href="/license/">源码授权说明</a>（含授权类型、历史版本协议与咨询方式）。</p>

            <h2>联系</h2>
            <% if (session.site && (session.site.phone || session.site.address || session.site.email)) { %>
            <ul class="contact-list">
                <% if (session.site.phone) { %><li>电话：<%= session.site.phone %></li><% } %>
                <% if (session.site.email) { %><li>邮箱：<%= session.site.email %></li><% } %>
                <% if (session.site.address) { %><li>所在城市：<%= session.site.address %></li><% } %>
            </ul>
            <% } else { %>
            <p>更多站点信息请看页脚。</p>
            <% } %>
        </div>
    </div>
    <%- include('common/sidebar') %>
</div>
<%- include('footer') %>
